<form class="actor-sheet {{ cssClass }}" autocomplete="off">
  {{> "systems/cowboy-bebop/templates/partials/actor-admin-panel.hbs"}}
  <header class="sheet-header">
    <img
      src="{{ actor.img }}"
      data-edit="img"
      title="{{ actor.name }}"
      height="64"
      width="64"
    />
    <div>
      <label>{{localize 'COWBOY.actor.name'}}</label>
      <input name="name" type="text" value="{{ actor.name }}" />
      <label>{{localize 'COWBOY.actor.concept'}}</label>
      <input
        name="system.concept"
        type="text"
        value="{{ actor.system.concept }}"
      />
    </div>
    <div class="cowboy-health">
      {{> "systems/cowboy-bebop/templates/partials/health-counter.hbs"}}
    </div>
    <div>
      <label>{{localize 'COWBOY.actor.memory'}}</label>
      <input
        name="system.memory"
        type="text"
        value="{{ actor.system.memory }}"
      />
      {{> "systems/cowboy-bebop/templates/partials/rythm-counter.hbs"}}
    </div>
  </header>

  {{!-- Cartons follow the hunter who made them until they are spent. The GM
  corrects each hunter's genre pools directly from this sheet. --}}
  <section class="cowboy-prime-tokens">
    <div class="cowboy-prime-tokens-container">
      {{> "systems/cowboy-bebop/templates/partials/token-counter.hbs" tokens=cartons on=false type="cartons" label=(localize 'COWBOY.actor.cartons') isGM=isGM }}
    </div>
  </section>

  <section class="cowboy-actor-traits">
    {{#each actor.system.traits as |traitCategory traitCategoryId|}}
    <div class="cowboy-actor-trait-cat-header">
      <h3 class="cowboy-actor-trait-name">
        {{!-- The same icon and colour this genre is drawn with on the dice, the
        tokens and the slice picker, read from the one table. --}}
        {{#with (lookup ../genreColors traitCategoryId)}}
        <i class="fa-solid {{ fa }} cowboy-actor-trait-cat-icon" style="color: {{ on }}"
          aria-hidden="true"></i>
        {{/with}}
        {{ traitCategoryId }}
      </h3>
      <button
        type="button"
        class="cowboy-actor-roll unbutton"
        data-category="{{ traitCategoryId }}"
      >
        {{ localize "COWBOY.actor.roll" }}
        <i class="fa-solid fa-dice"></i>
      </button>
    </div>
    <div class="cowboy-actor-trait-cat">
      {{#each traitCategory as |trait traitId|}}
      <div class="cowboy-actor-trait">
        <input
          class="cowboy-actor-trait-name 
            {{#if trait.hyperdamaged}}
            cowboy-actor-trait-ishyperdamaged
            {{else if trait.damaged }}
              cowboy-actor-trait-isdamaged
              
            {{/if}}"
          data-index="{{ traitId }}"
          data-category="{{ traitCategoryId }}"
          name="traits-{{ traitCategoryId }}-{{ traitId }}-name"
          type="text"
          value="{{ trait.name }}"
        />

        {{#if (and trait.damaged (not trait.hyperdamaged))}}
        <button
          type="button"
          class="cowboy-actor-trait-heal"
          data-index="{{ traitId }}"
          data-category="{{ traitCategoryId }}"
          title="{{localize 'COWBOY.actor.healTrait'}}"
          aria-label="{{localize 'COWBOY.actor.healTrait'}}"
        >
          <i class="fa-solid fa-notes-medical"></i>
        </button>
        {{else}}
        <input class="cowboy-actor-trait-status" data-index="{{ traitId }}"
        data-category="{{ traitCategoryId }}" name="traits-{{
          traitCategoryId
        }}-{{ traitId }}-damaged" type="checkbox"
        {{#if trait.damaged}}checked{{/if}}
        disabled />
        {{/if}}
      </div>
      {{/each}}
    </div>
    {{/each}}
  </section>

  {{!-- Ce que ce chasseur peut réellement jouer, là, maintenant. Quels riffs
  ce sont appartient à la session, donc la liste est lue sur la prime en jeu au
  lieu d'être tenue ici - et le dit franchement quand il n'y a pas de prime. --}}
  <section class="cowboy-actor-riffs">
    <header class="cowboy-actor-riffs-header">
      <h3><i class="fa-solid fa-guitar"></i> {{localize 'COWBOY.riffs.title'}}</h3>
      {{#if riffPrimeName}}
      <span class="cowboy-riff-mouvement">
        {{ riffMouvementName }}{{#if sessionType}} · {{ sessionType }}{{/if}}
      </span>
      {{/if}}
    </header>

    {{#if riffPrimeName}}
    {{> "systems/cowboy-bebop/templates/partials/riff-list.hbs" riffs=riffs}}
    {{else}}
    <p class="cowboy-prime-empty">{{localize 'COWBOY.actor.noActivePrime'}}</p>
    {{/if}}
  </section>
</form>

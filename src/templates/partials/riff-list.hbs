{{!-- L'aide elle-même : ce qu'on peut jouer maintenant. Repliée, parce qu'à la
table on lit les noms et on n'ouvre que celui qu'on s'apprête à plaquer. --}}
{{#if riffs.length}}
<ul class="cowboy-riff-list">
  {{#each riffs as |riff|}}
  <li class="cowboy-riff {{#if riff.custom}}is-custom{{/if}}">
    <details>
      <summary>
        <i class="fa-solid {{#if riff.custom}}fa-pen-nib{{else}}fa-guitar{{/if}}"></i>
        <span class="cowboy-riff-name">{{ riff.name }}</span>
      </summary>
      <p class="cowboy-riff-text">{{ riff.description }}</p>
    </details>
  </li>
  {{/each}}
</ul>
{{else}}
<p class="cowboy-prime-empty">{{localize 'COWBOY.riffs.none'}}</p>
{{/if}}

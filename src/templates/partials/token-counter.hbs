<div class="cowboy-actor-tokens">
  {{#unless hideLabel}}
  <div class="cowboy-actor-token-label">{{#if label}}{{ label }}{{else}}{{ type }}{{/if}}</div>
  {{/unless}}
  {{#each tokens as |token tokenId|}}
  <div class="cowboy-actor-token-pool">
    {{#if ../isGM}}
    <button type="button" class="cowboy-prime-tokens-add" data-genre="{{ tokenId }}" data-type="{{ ../type }}" data-actor-id="{{ ../actorId }}" data-value="-1" title="-1">&minus;</button>
    {{/if}}

    <div class="cowboy-actor-token cowboy-{{ ../type }}">
      {{ genreToIcon tokenId ../on }}
      <div class="cowboy-actor-token-value">{{ token }}</div>
    </div>

    {{#if ../isGM}}
    <button type="button" class="cowboy-prime-tokens-add" data-genre="{{ tokenId }}" data-type="{{ ../type }}" data-actor-id="{{ ../actorId }}" data-value="1" title="+1">+</button>
    {{/if}}
  </div>
  {{/each}}
</div>

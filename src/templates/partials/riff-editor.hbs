{{!-- Un bloc par mouvement, chacun coupé en deux : ce que les chasseurs peuvent
plaquer, ce que Big Shot peut leur opposer. Le mouvement en cours est déplié -
sur un type de session, aucun ne l'est, puisqu'il ne se joue pas.

Tout est dense à dessein. Cet écran n'est vu que par Big Shot, qui prépare une
session d'un coup puis n'y revient qu'à la marge : ce qui compte est de voir les
trois mouvements ensemble, pas de lire confortablement l'un d'eux. Un riff ouvert
tient donc sur une ligne, prix et effets compris, et les riffs fermés sont
ramassés en une rangée de cases à cocher.

Chaque ligne porte son propre `data-mouvement` : il vient des données, pas d'un
comptage de contextes parents. --}}
{{#each riffEditor as |block|}}
<details class="cowboy-riff-block {{#if block.current}}is-current{{/if}}" {{#if block.current}}open{{/if}}>
  <summary>
    <span class="cowboy-riff-block-name">{{ block.name }}</span>
    {{#if block.current}}
    <span class="cowboy-riff-block-badge">{{localize 'COWBOY.riffs.current'}}</span>
    {{/if}}
  </summary>

  {{!-- Corriger une fausse note n'est pas un riff, mais c'est la première chose
  qu'une session filler déplace vers le rythme, et aucun des huit riffs ne peut
  porter ce réglage (ADR 0008). Une ligne, avant eux, et un prix seul : ce n'est
  pas une Activation. --}}
  <div class="cowboy-riff-row is-rule">
    <span class="cowboy-riff-row-name"
      data-tooltip="{{localize 'COWBOY.riffs.correctionHint'}}">
      <i class="fa-solid fa-record-vinyl" aria-hidden="true"></i>
      {{localize 'COWBOY.riffs.correction'}}
    </span>
    {{#with block.correction}}
    {{> "systems/cowboy-bebop/templates/partials/correction-terms.hbs"}}
    {{/with}}
  </div>

  {{#each block.families as |family|}}
  <section class="cowboy-riff-family is-{{ family.audience }}">
    <h4 class="cowboy-riff-family-title">
      <i class="fa-solid {{ family.icon }}"></i> {{ family.title }}
    </h4>

    {{!-- Ce qui est ouvert : une ligne chacun, avec ce qu'il coûte et ce qu'il
    fait. Le formulaire est celui d'un groove — c'est la même mécanique, elle
    n'est dessinée qu'une fois (ADR 0012) — en mode `single`, parce qu'un riff
    porte exactement une activation. --}}
    {{#each family.open as |riff|}}
    <div class="cowboy-riff-row">
      <label class="cowboy-riff-row-name" data-tooltip="{{ riff.description }}">
        <input type="checkbox" class="cowboy-riff-toggle" data-mouvement="{{ riff.mouvement }}"
          data-riff="{{ riff.id }}" checked />
        <span>{{ riff.name }}</span>
      </label>

      {{> "systems/cowboy-bebop/templates/partials/activation-editor.hbs"
          activations=riff.activations single=true}}
    </div>
    {{/each}}

    {{!-- Ce qui ne l'est pas : des noms à cocher, sur une rangée. Un riff fermé
    n'a pas de prix à montrer, donc pas de ligne à occuper. --}}
    {{#if family.closed.length}}
    <div class="cowboy-riff-closed">
      {{#each family.closed as |riff|}}
      <label class="cowboy-riff-choice" data-tooltip="{{ riff.description }}">
        <input type="checkbox" class="cowboy-riff-toggle" data-mouvement="{{ riff.mouvement }}"
          data-riff="{{ riff.id }}" />
        <span>{{ riff.name }}</span>
      </label>
      {{/each}}
    </div>
    {{/if}}

    {{!-- Les riffs que cette histoire seule offre. C'est le nom qui les met sur
    la table : une ligne laissée vide n'est montrée à personne. --}}
    {{#each family.custom as |riff|}}
    <div class="cowboy-riff-row is-custom">
      <span class="cowboy-riff-row-name">
        <i class="fa-solid fa-pen-nib" aria-hidden="true"></i>
        <input type="text" class="cowboy-riff-custom-name" data-mouvement="{{ riff.mouvement }}"
          data-index="{{ riff.index }}" value="{{ riff.name }}"
          placeholder="{{localize 'COWBOY.riffs.customNamePlaceholder'}}" />
      </span>

      {{> "systems/cowboy-bebop/templates/partials/activation-editor.hbs"
          activations=riff.activations single=true}}

      <button type="button" class="cowboy-riff-custom-remove" data-mouvement="{{ riff.mouvement }}"
        data-index="{{ riff.index }}" data-tooltip="{{localize 'COWBOY.riffs.removeCustom'}}"
        aria-label="{{localize 'COWBOY.riffs.removeCustom'}}">
        <i class="fa-solid fa-trash"></i>
      </button>

      {{!-- Le rappel que la table lira au survol du badge. Une seule ligne : ce
      qu'un riff permet s'écrit court, et ce qui déborde reste lisible au
      survol. --}}
      <textarea class="cowboy-riff-custom-description" rows="1" data-mouvement="{{ riff.mouvement }}"
        data-index="{{ riff.index }}"
        placeholder="{{localize 'COWBOY.riffs.customDescriptionPlaceholder'}}">{{ riff.description }}</textarea>
    </div>
    {{/each}}

    <button type="button" class="cowboy-riff-custom-add" data-mouvement="{{ family.mouvement }}"
      data-audience="{{ family.audience }}">
      <i class="fa-solid fa-plus"></i>
      {{localize 'COWBOY.riffs.addCustom'}}
    </button>
  </section>
  {{/each}}
</details>
{{/each}}

{
  "$schema": "https://json.schemastore.org/foundryvtt-manifest.json",
  "id": "cowboy-bebop",
  "title": "Cowboy Bebop System",
  "description": "A template module using Typescript. You should change name, title, and description in module.json.",
  "version": "1.0.0",
  "packs": [],
  "system": [],
  "dependencies": [],
  "scripts": [],
  "compatibility": {
    "minimum": "13",
    "verified": "14",
    "maximum": "14"
  },
  "relationships": {
    "requires": [
      {
        "id": "sliced-dials",
        "type": "module",
        "reason": "Objective and threat dials are drawn and driven by Sliced Dials."
      }
    ]
  },
  "documentTypes": {
    "ChatMessage": {
      "rollMessage": {}
    }
  },
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "languages/en.json"
    },
    {
      "lang": "fr",
      "name": "Français",
      "path": "languages/fr.json"
    }
  ],
  "styles": ["scripts/assets/module.css"],
  "esmodules": ["scripts/module.js"]
}
